# =========================================================================
# CampusGig .gitignore
# Professional Standard Git Ignore for Spring Boot & Java Projects
# =========================================================================

# Compiled class files & build artifacts
target/
*.class

# Package files
*.jar
*.war
*.ear

# Logs
*.log
logs/

# IDE files
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath

# Keep useful VS Code launch/task configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.bak
*.swp
*~
