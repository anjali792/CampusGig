{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🧹 Free Port 8080 (Clear Zombie Server)",
            "type": "shell",
            "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 8080 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "▶️ Run CampusGig (Spring Boot Server)",
            "type": "shell",
            "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 8080 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"; .\\mvnw.cmd spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "JAVA_HOME": "C:\\Users\\ANJALI SINGH SENGAR\\.jdk\\jdk-17",
                    "Path": "C:\\Users\\ANJALI SINGH SENGAR\\.jdk\\jdk-17\\bin;C:\\Users\\ANJALI SINGH SENGAR\\.maven\\apache-maven-3.9.9\\bin;${env:Path}"
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "🌐 Open CampusGig in Browser (http://localhost:8080)",
            "type": "shell",
            "command": "cmd.exe /c start http://localhost:8080",
            "problemMatcher": [],
            "group": "none"
        },
        {
            "label": "⚡ Open Standalone Interactive HTML Preview",
            "type": "shell",
            "command": "cmd.exe /c start CampusGig_Interactive_Preview.html",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "📦 Maven Package Clean JAR",
            "type": "shell",
            "command": ".\\mvnw.cmd clean package -DskipTests",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "JAVA_HOME": "C:\\Users\\ANJALI SINGH SENGAR\\.jdk\\jdk-17",
                    "Path": "C:\\Users\\ANJALI SINGH SENGAR\\.jdk\\jdk-17\\bin;C:\\Users\\ANJALI SINGH SENGAR\\.maven\\apache-maven-3.9.9\\bin;${env:Path}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "🚀 1-Click Deploy to GitHub",
            "type": "shell",
            "command": "cmd.exe /c \"git add . && git commit -m \\\"feat: updates from VS Code\\\" && git push origin main\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
